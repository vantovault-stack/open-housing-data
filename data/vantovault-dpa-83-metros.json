{
 "meta": {
  "dataset": "VanToVault Down Payment Assistance Survey - can you use DPA on a 2-4 unit home?",
  "description": "83 US metro areas screened for a single question: can an owner-occupant use down payment assistance to buy a two-to-four unit property and live in one unit? Most program websites speak only of a single-family home and leave the rest to interpretation, so where the answer was unclear the administering agency was contacted directly and several confirmed their answer in writing.",
  "data_as_of": "2026-07",
  "license": "CC BY 4.0 - use with attribution to Van to Vault (vantovault.com)",
  "methodology": "https://vantovault.com/library/down-payment-assistance-duplex/",
  "record_count": 83,
  "status_counts": {
   "program_found": 69,
   "none_found": 10,
   "unconfirmed": 4
  },
  "status_values": {
   "program_found": "A down payment assistance program usable on a 2-4 unit owner-occupied purchase was identified. max_assistance_usd is that program's advertised maximum.",
   "none_found": "The metro's state and local DPA product line was checked and no 2-4 unit-eligible program was found, or the relevant program explicitly excludes 2-4 unit property.",
   "unconfirmed": "A DPA program exists but its 2-4 unit eligibility is not stated on the program's own materials and could not be confirmed. Treat as unknown, not as a no."
  },
  "notes": "max_assistance_usd is the maximum the named program advertises, not an amount any individual buyer will qualify for; income, price and location caps all apply. It is blank for any row that is not program_found. Always check the source_url and speak to the agency before relying on a figure. program_or_finding carries the program name for program_found rows and the research finding otherwise.",
  "fields": [
   "metro",
   "status",
   "max_assistance_usd",
   "program_or_finding",
   "source_url",
   "as_of"
  ]
 },
